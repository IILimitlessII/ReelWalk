<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:ReelWalk.Views"
             xmlns:models="using:ReelWalk.Models"
             x:Class="ReelWalk.Views.SettingsView"
             HorizontalAlignment="Center"
             VerticalAlignment="Center"
             IsVisible="{Binding IsSettingsVisible}">
    <Border Background="{DynamicResource ThemePanelBrush}"
            Padding="32,28"
            MinWidth="560"
            MaxWidth="640"
            MaxHeight="820"
            CornerRadius="12">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,24">
                <TextBlock Text="Settings"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>
                <TextBlock Text="Changes apply now. Library folders stay in ReelWalk.toml."
                           Foreground="#CCCCCC"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom"
                       Margin="0,24,0,0"
                       Text="Click outside or press Escape to close. Escape cancels a key capture."
                       Foreground="#AAAAAA"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="28" Margin="0,0,16,0">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Theme"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <Button Content="Harbor Blue" Classes="mode"
                                    Classes.hot="{Binding SettingsThemeIsHarbor}"
                                    Command="{Binding SetSettingsThemeCommand}"
                                    CommandParameter="HarborBlue"/>
                            <Button Content="Dark Slate" Classes="mode"
                                    Classes.hot="{Binding SettingsThemeIsDarkSlate}"
                                    Command="{Binding SetSettingsThemeCommand}"
                                    CommandParameter="DarkSlate"/>
                            <Button Content="Jungle Green" Classes="mode"
                                    Classes.hot="{Binding SettingsThemeIsJungle}"
                                    Command="{Binding SetSettingsThemeCommand}"
                                    CommandParameter="JungleGreen"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <Button Content="Midnight Starry Sky" Classes="mode"
                                    Classes.hot="{Binding SettingsThemeIsMidnight}"
                                    Command="{Binding SetSettingsThemeCommand}"
                                    CommandParameter="MidnightSky"/>
                            <Button Content="Pastel Dreams" Classes="mode"
                                    Classes.hot="{Binding SettingsThemeIsPastel}"
                                    Command="{Binding SetSettingsThemeCommand}"
                                    CommandParameter="PastelDreams"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="12">
                        <TextBlock Text="Display"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <Grid ColumnDefinitions="168,200"
                              ColumnSpacing="20"
                              RowDefinitions="Auto,Auto,Auto,Auto"
                              RowSpacing="12"
                              HorizontalAlignment="Center">
                            <TextBlock Text="Duration (s)" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <local:ThemeStepper Grid.Column="1"
                                               HorizontalAlignment="Stretch"
                                               Minimum="1" Maximum="60" Increment="1"
                                               FormatString="0.0"
                                               Value="{Binding SettingsDuration}"/>
                            <TextBlock Grid.Row="1" Text="Transition %" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <local:ThemeStepper Grid.Row="1" Grid.Column="1"
                                               HorizontalAlignment="Stretch"
                                               Minimum="0" Maximum="100" Increment="1"
                                               FormatString="0.0"
                                               Value="{Binding SettingsTransitionPercent}"/>
                            <TextBlock Grid.Row="2" Text="Fit" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Content="Contain" Classes="mode"
                                        Classes.hot="{Binding SettingsFitIsContain}"
                                        Command="{Binding SetSettingsFitCommand}"
                                        CommandParameter="Contain"/>
                                <Button Content="Cover" Classes="mode"
                                        Classes.hot="{Binding SettingsFitIsCover}"
                                        Command="{Binding SetSettingsFitCommand}"
                                        CommandParameter="Cover"/>
                            </StackPanel>
                            <TextBlock Grid.Row="3" Text="Volume" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <local:ThemeStepper Grid.Row="3" Grid.Column="1"
                                               HorizontalAlignment="Stretch"
                                               Minimum="0" Maximum="1" Increment="0.05"
                                               FormatString="0.00"
                                               Value="{Binding SettingsVolume}"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="12">
                        <TextBlock Text="Playback"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Mode" Foreground="#CCCCCC" FontSize="12" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <Button Content="Random" Classes="mode"
                                    Classes.hot="{Binding SettingsModeIsRandom}"
                                    Command="{Binding SetSettingsPlaybackModeCommand}"
                                    CommandParameter="Random"/>
                            <Button Content="Newest" Classes="mode"
                                    Classes.hot="{Binding SettingsModeIsNewest}"
                                    Command="{Binding SetSettingsPlaybackModeCommand}"
                                    CommandParameter="NewestFirst"/>
                            <Button Content="Oldest" Classes="mode"
                                    Classes.hot="{Binding SettingsModeIsOldest}"
                                    Command="{Binding SetSettingsPlaybackModeCommand}"
                                    CommandParameter="OldestFirst"/>
                            <Button Content="Sequential" Classes="mode"
                                    Classes.hot="{Binding SettingsModeIsSequential}"
                                    Command="{Binding SetSettingsPlaybackModeCommand}"
                                    CommandParameter="Sequential"/>
                        </StackPanel>
                        <TextBlock Text="Show" Foreground="#CCCCCC" FontSize="12" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <Button Content="Both" Classes="mode"
                                    Classes.hot="{Binding SettingsShowIsBoth}"
                                    Command="{Binding SetSettingsMediaShowCommand}"
                                    CommandParameter="Both"/>
                            <Button Content="Images" Classes="mode"
                                    Classes.hot="{Binding SettingsShowIsImages}"
                                    Command="{Binding SetSettingsMediaShowCommand}"
                                    CommandParameter="Images"/>
                            <Button Content="Videos" Classes="mode"
                                    Classes.hot="{Binding SettingsShowIsVideos}"
                                    Command="{Binding SetSettingsMediaShowCommand}"
                                    CommandParameter="Videos"/>
                        </StackPanel>
                        <TextBlock Text="Folder play" Foreground="#CCCCCC" FontSize="12" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <Button Content="Random" Classes="mode"
                                    Classes.hot="{Binding SettingsFolderIsRandom}"
                                    Command="{Binding SetSettingsFolderModeCommand}"
                                    CommandParameter="Random"/>
                            <Button Content="Ordered" Classes="mode"
                                    Classes.hot="{Binding SettingsFolderIsOrdered}"
                                    Command="{Binding SetSettingsFolderModeCommand}"
                                    CommandParameter="Sequential"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <Button Content="Smallest" Classes="mode"
                                    Classes.hot="{Binding SettingsFolderIsSizeAsc}"
                                    Command="{Binding SetSettingsFolderModeCommand}"
                                    CommandParameter="SizeAsc"/>
                            <Button Content="Largest" Classes="mode"
                                    Classes.hot="{Binding SettingsFolderIsSizeDesc}"
                                    Command="{Binding SetSettingsFolderModeCommand}"
                                    CommandParameter="SizeDesc"/>
                            <Button Content="Shortest" Classes="mode"
                                    Classes.hot="{Binding SettingsFolderIsLengthAsc}"
                                    Command="{Binding SetSettingsFolderModeCommand}"
                                    CommandParameter="LengthAsc"/>
                            <Button Content="Longest" Classes="mode"
                                    Classes.hot="{Binding SettingsFolderIsLengthDesc}"
                                    Command="{Binding SetSettingsFolderModeCommand}"
                                    CommandParameter="LengthDesc"/>
                        </StackPanel>
                        <Button Content="Include subfolders"
                                Classes="mode"
                                Classes.hot="{Binding SettingsFolderSubfolders}"
                                HorizontalAlignment="Center"
                                Command="{Binding ToggleSettingsFolderSubfoldersCommand}"/>
                        <Grid ColumnDefinitions="168,200" ColumnSpacing="20" HorizontalAlignment="Center">
                            <TextBlock Text="History" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <local:ThemeStepper Grid.Column="1"
                                               HorizontalAlignment="Stretch"
                                               Minimum="1" Maximum="500" Increment="1"
                                               FormatString="0"
                                               Value="{Binding SettingsHistory}"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="12">
                        <TextBlock Text="Transitions"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <Button Content="Crossfade" Classes="mode"
                                    Classes.hot="{Binding SettingsFxCrossfade}"
                                    Command="{Binding ToggleSettingsFxCrossfadeCommand}"/>
                            <Button Content="MorphZoom" Classes="mode"
                                    Classes.hot="{Binding SettingsFxMorphZoom}"
                                    Command="{Binding ToggleSettingsFxMorphZoomCommand}"/>
                            <Button Content="SoftWipe" Classes="mode"
                                    Classes.hot="{Binding SettingsFxSoftWipe}"
                                    Command="{Binding ToggleSettingsFxSoftWipeCommand}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <Button Content="ParallaxReveal" Classes="mode"
                                    Classes.hot="{Binding SettingsFxParallaxReveal}"
                                    Command="{Binding ToggleSettingsFxParallaxRevealCommand}"/>
                            <Button Content="ScaleDissolve" Classes="mode"
                                    Classes.hot="{Binding SettingsFxScaleDissolve}"
                                    Command="{Binding ToggleSettingsFxScaleDissolveCommand}"/>
                            <Button Content="Ken Burns" Classes="mode"
                                    Classes.hot="{Binding SettingsKenBurns}"
                                    Command="{Binding ToggleSettingsKenBurnsCommand}"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="168,200"
                              ColumnSpacing="20"
                              RowDefinitions="Auto,Auto"
                              RowSpacing="12"
                              HorizontalAlignment="Center">
                            <TextBlock Text="Ken Burns (s)" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <local:ThemeStepper Grid.Column="1"
                                               HorizontalAlignment="Stretch"
                                               Minimum="0.5" Maximum="600" Increment="0.5"
                                               FormatString="0.0"
                                               Value="{Binding SettingsKenBurnsDuration}"/>
                            <TextBlock Grid.Row="1" Text="Ken Burns zoom" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <local:ThemeStepper Grid.Row="1" Grid.Column="1"
                                               HorizontalAlignment="Stretch"
                                               Minimum="1" Maximum="3" Increment="0.1"
                                               FormatString="0.0"
                                               Value="{Binding SettingsKenBurnsMaxZoom}"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="12">
                        <TextBlock Text="Controls"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <Grid ColumnDefinitions="168,200"
                              ColumnSpacing="20"
                              RowDefinitions="Auto,Auto,Auto"
                              RowSpacing="12"
                              HorizontalAlignment="Center">
                            <TextBlock Text="Skip files" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <local:ThemeStepper Grid.Column="1"
                                               HorizontalAlignment="Stretch"
                                               Minimum="1" Maximum="500" Increment="1"
                                               FormatString="0"
                                               Value="{Binding SettingsSkip}"/>
                            <TextBlock Grid.Row="1" Text="Seek (s)" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <local:ThemeStepper Grid.Row="1" Grid.Column="1"
                                               HorizontalAlignment="Stretch"
                                               Minimum="0.5" Maximum="600" Increment="1"
                                               FormatString="0"
                                               Value="{Binding SettingsSeekSeconds}"/>
                            <TextBlock Grid.Row="2" Text="Seek fast (s)" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <local:ThemeStepper Grid.Row="2" Grid.Column="1"
                                               HorizontalAlignment="Stretch"
                                               Minimum="0.5" Maximum="600" Increment="1"
                                               FormatString="0"
                                               Value="{Binding SettingsSeekFastSeconds}"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="12">
                        <TextBlock Text="Keybinds"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Click a binding, then press the new key combo."
                                   Foreground="#CCCCCC"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                        <ItemsControl ItemsSource="{Binding Keybinds}" HorizontalAlignment="Center">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:KeybindItem">
                                    <Grid ColumnDefinitions="200,180" ColumnSpacing="20" Margin="0,4">
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="White"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="1"
                                                Content="{Binding ButtonLabel}"
                                                Classes="mode"
                                                Classes.hot="{Binding IsCapturing}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                Command="{Binding $parent[UserControl].DataContext.BeginKeyCaptureCommand}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
