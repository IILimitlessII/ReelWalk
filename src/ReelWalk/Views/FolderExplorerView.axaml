<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:ReelWalk.Models"
             x:Class="ReelWalk.Views.FolderExplorerView"
             HorizontalAlignment="Center"
             VerticalAlignment="Center"
             IsVisible="{Binding IsFolderMenuVisible}">
    <Border Background="{DynamicResource ThemePanelBrush}"
            Padding="32,28"
            MinWidth="560"
            MaxWidth="680"
            MaxHeight="860"
            CornerRadius="12">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,20">
                <Grid ColumnDefinitions="88,*,88">
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="{Binding ExplorerTitle}"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ExplorerDetail}"
                                   Foreground="#BBBBBB"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Content="Up"
                            Classes="mode"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Command="{Binding ExplorerGoUpCommand}"
                            IsVisible="{Binding !ExplorerAtLibraryRoot}"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <Button Content="Random" Classes="mode"
                            Classes.hot="{Binding FolderPlayIsRandom}"
                            Command="{Binding SetFolderPlayRandomCommand}"/>
                    <Button Content="Ordered" Classes="mode"
                            Classes.hot="{Binding !FolderPlayIsRandom}"
                            Command="{Binding SetFolderPlayOrderedCommand}"/>
                    <Button Content="Subfolders" Classes="mode"
                            Classes.hot="{Binding FolderIncludesSubfolders}"
                            Command="{Binding SetFolderSubfoldersCommand}"/>
                    <Button Content="This folder" Classes="mode"
                            Classes.hot="{Binding !FolderIncludesSubfolders}"
                            Command="{Binding SetFolderThisOnlyCommand}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <Button Content="Add library folder…" Classes="mode"
                            Command="{Binding AddLibraryPathFromPickerCommand}"/>
                    <Button Content="Go to folder…" Classes="mode"
                            Command="{Binding BrowseToPickedFolderCommand}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                            IsVisible="{Binding CanManageBrowsePath}">
                    <Button Content="Add here to library" Classes="mode"
                            Command="{Binding AddBrowsePathToLibraryCommand}"/>
                    <Button Content="Ignore this folder" Classes="mode"
                            Classes.hot="{Binding ExplorerBrowsePathIgnored}"
                            Command="{Binding ToggleBrowsePathIgnoreCommand}"/>
                    <Button Content="Show in Explorer" Classes="mode"
                            Command="{Binding OpenBrowsePathInExplorerCommand}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,20,0,0">
                <Button Content="{Binding PlayBrowseLabel}"
                        Classes="folder"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Command="{Binding PlayBrowseFolderCommand}"
                        IsVisible="{Binding CanPlayBrowse}"/>
                <Button Content="Resume library"
                        Classes="folder"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Command="{Binding StopFolderPlayCommand}"
                        IsVisible="{Binding IsFolderPlaying}"/>
                <TextBlock Text="Type to find · Enter play · Right open · Left back · ↑↓ move"
                           Foreground="#999999"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="20" Margin="0,0,16,4">
                    <StackPanel Spacing="8" IsVisible="{Binding ExplorerAtLibraryRoot}">
                        <TextBlock Text="Library folders"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <ItemsControl ItemsSource="{Binding LibraryPathItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:LibraryPathItem">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,2">
                                        <TextBlock Text="{Binding Name}"
                                                   ToolTip.Tip="{Binding FullPath}"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="1" Content="Open" Classes="mode"
                                                Command="{Binding $parent[UserControl].DataContext.OpenExplorerFolderCommand}"
                                                CommandParameter="{Binding FullPath}"/>
                                        <Button Grid.Column="2" Content="Remove" Classes="mode"
                                                Command="{Binding $parent[UserControl].DataContext.RemoveLibraryPathCommand}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No library folders yet. Use Add library folder."
                                   Foreground="#888888"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   IsVisible="{Binding !HasLibraryPathItems}"/>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Ignored folders"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <ItemsControl ItemsSource="{Binding IgnorePathItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:IgnorePathItem">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,2">
                                        <TextBlock Text="{Binding Name}"
                                                   ToolTip.Tip="{Binding FullPath}"
                                                   Foreground="#CCCCCC"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="1" Content="Open" Classes="mode"
                                                Command="{Binding $parent[UserControl].DataContext.OpenExplorerFolderCommand}"
                                                CommandParameter="{Binding FullPath}"/>
                                        <Button Grid.Column="2" Content="Remove" Classes="mode"
                                                Command="{Binding $parent[UserControl].DataContext.RemoveIgnorePathCommand}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="None ignored. Use Ignore this folder while browsing."
                                   Foreground="#888888"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding !HasIgnorePathItems}"/>
                    </StackPanel>

                    <TextBlock Text="{Binding ExplorerQueryLabel}"
                               Foreground="{DynamicResource ThemeLinkBrush}"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               IsVisible="{Binding HasExplorerQuery}"/>

                    <ScrollViewer MaxHeight="56"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  HorizontalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding FolderChoices}" HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="\"
                                                   Margin="8,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="#666666"
                                                   FontSize="14"
                                                   IsVisible="{Binding ShowSeparator}"/>
                                        <Button Content="{Binding Name}"
                                                Classes="folder"
                                                Classes.selected="{Binding IsSelected}"
                                                ToolTip.Tip="{Binding FullPath}"
                                                Focusable="False"
                                                FontSize="13"
                                                Padding="8,4"
                                                HorizontalAlignment="Center"
                                                HorizontalContentAlignment="Center"
                                                Command="{Binding $parent[UserControl].DataContext.OpenExplorerFolderCommand}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Spacing="8" IsVisible="{Binding HasExplorerFolders}">
                        <TextBlock Text="Folders here"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <ListBox x:Name="ExplorerList"
                                 ItemsSource="{Binding ExplorerFolders}"
                                 SelectedItem="{Binding SelectedExplorer, Mode=OneWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="White"
                                 Focusable="False"
                                 Padding="0,0,0,8">
                            <ListBox.Resources>
                                <ControlTheme x:Key="{x:Type ListBoxItem}" TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,4"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Template">
                                        <ControlTemplate>
                                            <ContentPresenter Background="{TemplateBinding Background}"
                                                              Foreground="{TemplateBinding Foreground}"
                                                              Padding="{TemplateBinding Padding}"
                                                              Content="{TemplateBinding Content}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                        </ControlTemplate>
                                    </Setter>
                                    <Style Selector="^:pointerover">
                                        <Setter Property="Background" Value="{DynamicResource ThemeAccentWashBrush}"/>
                                    </Style>
                                    <Style Selector="^:selected">
                                        <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ThemeOnAccentBrush}"/>
                                    </Style>
                                </ControlTheme>
                            </ListBox.Resources>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <Button Grid.Column="0"
                                                Classes="folder"
                                                Classes.selected="{Binding IsSelected}"
                                                Focusable="False"
                                                ToolTip.Tip="{Binding ToolTipText}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Command="{Binding $parent[UserControl].DataContext.PlayFolderChoiceCommand}"
                                                CommandParameter="{Binding}">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding CountLabel}"
                                                           Margin="12,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="#CCCCCC"
                                                           FontSize="12"/>
                                                <TextBlock DockPanel.Dock="Left"
                                                           Text="{Binding StatusLabel}"
                                                           Margin="0,0,8,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource ThemeLinkBrush}"
                                                           FontSize="11"/>
                                                <TextBlock Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           Foreground="White"/>
                                            </DockPanel>
                                        </Button>
                                        <Button Grid.Column="1"
                                                Content="Ignore"
                                                Classes="mode"
                                                Classes.hot="{Binding IsIgnored}"
                                                Focusable="False"
                                                VerticalAlignment="Center"
                                                Command="{Binding $parent[UserControl].DataContext.ToggleFolderIgnoreCommand}"
                                                CommandParameter="{Binding}"/>
                                        <Button Grid.Column="2"
                                                Content="Open"
                                                Classes="mode"
                                                Focusable="False"
                                                VerticalAlignment="Center"
                                                ToolTip.Tip="Look inside"
                                                Command="{Binding $parent[UserControl].DataContext.OpenExplorerFolderCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding HasChildren}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <TextBlock Text="{Binding ExplorerEmptyText}"
                               Foreground="#AAAAAA"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               IsVisible="{Binding ExplorerIsEmpty}"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
