<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Kill Fluent/Windows accent yellow on every button hover/press. -->
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}"/>
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ThemeAccentStrongBrush}"/>
    </Style>

    <Style Selector="Button.folder">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#F2F2F2"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.folder:pointerover">
        <Setter Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}"/>
    </Style>
    <Style Selector="Button.folder:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}"/>
    </Style>
    <Style Selector="Button.folder.selected">
        <Setter Property="Foreground" Value="{DynamicResource ThemeOnAccentBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
    </Style>
    <Style Selector="Button.folder.selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeOnAccentBrush}"/>
    </Style>
    <Style Selector="Button.folder.selected:pointerover">
        <Setter Property="Background" Value="{DynamicResource ThemeAccentHoverBrush}"/>
    </Style>
    <Style Selector="Button.folder.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ThemeAccentHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeOnAccentBrush}"/>
    </Style>

    <Style Selector="Button.mode">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.mode:pointerover">
        <Setter Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}"/>
    </Style>
    <Style Selector="Button.mode:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}"/>
    </Style>
    <Style Selector="Button.mode.hot">
        <Setter Property="Foreground" Value="{DynamicResource ThemeOnAccentBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
    </Style>
    <Style Selector="Button.mode.hot /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeOnAccentBrush}"/>
    </Style>
    <Style Selector="Button.mode.hot:pointerover">
        <Setter Property="Background" Value="{DynamicResource ThemeAccentHoverBrush}"/>
    </Style>
    <Style Selector="Button.mode.hot:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ThemeAccentHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeOnAccentBrush}"/>
    </Style>

    <!-- Stepper arrows follow the active theme. -->
    <Style Selector="Button.spin">
        <Setter Property="Background" Value="{DynamicResource ThemeSpinBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.spin:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeOnAccentBrush}"/>
    </Style>
    <Style Selector="Button.spin:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ThemeAccentPressBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeOnAccentBrush}"/>
    </Style>

    <!-- Settings text fields: selection and caret follow the theme. -->
    <Style Selector="TextBox.bluefield">
        <Setter Property="Foreground" Value="{DynamicResource ThemeFieldTextBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource ThemeCaretBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource ThemeAccentStrongBrush}"/>
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource ThemeFieldTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="TextBox.bluefield:focus">
        <Setter Property="Foreground" Value="{DynamicResource ThemeFieldTextBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource ThemeCaretBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource ThemeAccentStrongBrush}"/>
    </Style>
    <Style Selector="TextBox.bluefield /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="TextBox.bluefield:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="TextBox.bluefield:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <Style Selector="ScrollBar /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource ThemeAccentMidBrush}"/>
    </Style>
    <Style Selector="ScrollBar /template/ Thumb:pointerover">
        <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
    </Style>
</Styles>
