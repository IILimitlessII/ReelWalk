<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Kill Fluent/Windows accent yellow on every button hover/press. -->
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#2F7CF055"/>
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#2F7CF088"/>
    </Style>

    <Style Selector="Button.folder">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#F2F2F2"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.folder:pointerover">
        <Setter Property="Background" Value="#2F7CF055"/>
    </Style>
    <Style Selector="Button.folder:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#2F7CF055"/>
    </Style>
    <Style Selector="Button.folder.selected">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#2F7CF0"/>
    </Style>
    <Style Selector="Button.folder.selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#2F7CF0"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.folder.selected:pointerover">
        <Setter Property="Background" Value="#5B94F5"/>
    </Style>
    <Style Selector="Button.folder.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#5B94F5"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector="Button.mode">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.mode:pointerover">
        <Setter Property="Background" Value="#2F7CF055"/>
    </Style>
    <Style Selector="Button.mode:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#2F7CF055"/>
    </Style>
    <Style Selector="Button.mode.hot">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#2F7CF0"/>
    </Style>
    <Style Selector="Button.mode.hot /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#2F7CF0"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.mode.hot:pointerover">
        <Setter Property="Background" Value="#5B94F5"/>
    </Style>
    <Style Selector="Button.mode.hot:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#5B94F5"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- Custom stepper arrows: hardcoded blue, never OS accent. -->
    <Style Selector="Button.spin">
        <Setter Property="Background" Value="#2F7CF033"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.spin:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#2F7CF0"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.spin:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#2563EB"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- Settings text fields: selection/caret/focus all blue. -->
    <Style Selector="TextBox.bluefield">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="CaretBrush" Value="#5B94F5"/>
        <Setter Property="SelectionBrush" Value="#2F7CF088"/>
        <Setter Property="SelectionForegroundBrush" Value="White"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="TextBox.bluefield:focus">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="CaretBrush" Value="#5B94F5"/>
        <Setter Property="SelectionBrush" Value="#2F7CF088"/>
    </Style>
    <Style Selector="TextBox.bluefield /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="TextBox.bluefield:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="TextBox.bluefield:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <Style Selector="ScrollBar /template/ Thumb">
        <Setter Property="Background" Value="#2F7CF066"/>
    </Style>
    <Style Selector="ScrollBar /template/ Thumb:pointerover">
        <Setter Property="Background" Value="#2F7CF0"/>
    </Style>
</Styles>
