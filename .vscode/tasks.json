{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/src/ReelWalk/ReelWalk.csproj",
        "-c",
        "Debug",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "linux": {
        "options": {
          "env": {
            "DOTNET_ROOT": "${env:HOME}/.dotnet",
            "PATH": "${env:HOME}/.dotnet:${env:PATH}"
          }
        }
      },
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "build-linux",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/src/ReelWalk/ReelWalk.csproj",
        "-c",
        "Debug",
        "-r",
        "linux-x64",
        "--self-contained",
        "false",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "linux": {
        "options": {
          "env": {
            "DOTNET_ROOT": "${env:HOME}/.dotnet",
            "PATH": "${env:HOME}/.dotnet:${env:PATH}"
          }
        }
      },
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "build-windows",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/src/ReelWalk/ReelWalk.csproj",
        "-c",
        "Debug",
        "-r",
        "win-x64",
        "--self-contained",
        "false",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    }
  ]
}
